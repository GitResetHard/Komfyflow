# Copy to .env. Never commit real credentials. Docker interpolates these values.
APP_URL=http://localhost:3000
DATABASE_URL=mysql://komfyflow:replace-database-password@localhost:3306/komfyflow
MARIADB_PASSWORD=replace-database-password
MARIADB_ROOT_PASSWORD=replace-root-password
SESSION_SECRET=replace-with-at-least-32-random-characters
REDIS_URL=redis://localhost:6379
# Local development only. Production uses private Backblaze B2.
STORAGE_DRIVER=local
STORAGE_DIR=/app/storage
ALLOW_LOCAL_STORAGE=true
B2_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
# Transactional mail adapter: POST {to, template: verify|reset, link}.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
# Enable only behind a reverse proxy that overwrites forwarding headers.
TRUST_PROXY=false

# Public deployments should require verified emails before uploads.
REQUIRE_VERIFIED_UPLOADS=true
